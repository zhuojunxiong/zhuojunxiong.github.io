---
import BaseLayout from "./BaseLayout.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import { formatDate, slugFromId } from "../utils/content";

const { entry, Content, previous, next } = Astro.props;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  current="articles"
  image={entry.data.cover}
  imageAlt={entry.data.coverAlt}
  ogType="article"
  schemaType="Article"
  publishedDate={entry.data.publishedDate}
  updatedDate={entry.data.updatedDate}
>
  <ReadingProgress />
  <article class="post-shell">
    <header class="post-header">
      <p class="eyebrow">{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <div class="meta">
        <span>Published {formatDate(entry.data.publishedDate)}</span>
        {entry.data.updatedDate && <span>Updated {formatDate(entry.data.updatedDate)}</span>}
      </div>
      {
        entry.data.cover && (
          <div class="post-cover">
            <img
              src={entry.data.cover}
              alt={entry.data.coverAlt}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-license">
      <p>
        © {new Date(entry.data.publishedDate).getFullYear()} Liuwuxin. Licensed under <a
          href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a
        >: attribution is required, and adaptations must use the same license.
      </p>
    </footer>
    <nav class="post-nav" aria-label="Previous and next essays">
      {
        previous ? (
          <a href={`/articles/${slugFromId(previous.id)}/`}>
            Previous
            <>
              <br />
              <strong>{previous.data.title}</strong>
            </>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/articles/${slugFromId(next.id)}/`}>
            Next
            <>
              <br />
              <strong>{next.data.title}</strong>
            </>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>
