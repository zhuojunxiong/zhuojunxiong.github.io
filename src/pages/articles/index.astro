---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byDateDesc, formatDate, isPublished, slugFromId } from "../../utils/content";

const posts = (await getCollection("articles")).filter(isPublished).sort(byDateDesc);
---

<BaseLayout
  title="Essays"
  description="Essays on travel, photography, daily life, and the questions that resist a final answer."
  current="articles"
  image={posts.find((post) => post.data.cover)?.data.cover}
  imageAlt={posts.find((post) => post.data.cover)?.data.coverAlt}
>
  <section class="page-hero">
    <div class="section-inner page-hero-grid">
      <div>
        <p class="eyebrow">Essays & Notes</p>
        <h1>Essays</h1>
      </div>
      <div>
        <p class="lead">
          Beyond code lie the things that still ask for patient attention: travel, reading, ordinary
          days, and thoughts not yet ready to become conclusions.
        </p>
        <p class="page-hero-note">
          Words may take their time. Sometimes their only duty is to keep a moment true.
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="section-inner article-list">
      {
        posts.map((post) => (
          <article class="article-card" data-reveal>
            {post.data.cover && (
              <a class="article-card-media" href={`/articles/${slugFromId(post.id)}/`}>
                <img
                  src={post.data.cover}
                  alt={post.data.coverAlt}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
            <div class="meta">
              <span>{formatDate(post.data.publishedDate)}</span>
              <span>{post.data.category}</span>
            </div>
            <h2>
              <a href={`/articles/${slugFromId(post.id)}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <a class="text-link" href={`/articles/${slugFromId(post.id)}/`}>
              Continue reading
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
