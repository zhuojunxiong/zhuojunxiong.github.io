---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byDateDesc, formatDate, isPublished } from "../../utils/content";

const galleries = (await getCollection("photography")).filter(isPublished).sort(byDateDesc);
---

<BaseLayout
  title="Photography"
  description="Photographic essays about landscape, light, distance, and the quiet act of looking."
  current="photography"
  image={galleries[0]?.data.cover}
  imageAlt={galleries[0]?.data.coverAlt}
>
  <section class="page-hero">
    <div class="section-inner page-hero-grid">
      <div>
        <p class="eyebrow">Photography</p>
        <h1>Photography</h1>
      </div>
      <div>
        <p class="lead">
          Some experiences ask to be explained; others ask only to be seen. These sequences hold
          light, distance, and the temper of a passing gaze.
        </p>
        <p class="page-hero-note">
          Each collection follows its own rhythm, accompanied by a brief field note.
        </p>
      </div>
    </div>
  </section>
  <section class="section gallery-index">
    <div class="section-inner">
      {
        galleries.map((gallery, index) => {
          const slug = gallery.id.replace(/\.json$/, "");
          const coverPhoto = gallery.data.photos.find((photo) => photo.src === gallery.data.cover);
          return (
            <article class="gallery-card" data-reveal>
              <a class="gallery-card-media" href={`/photography/${slug}/`}>
                <img
                  src={gallery.data.cover}
                  alt={gallery.data.coverAlt}
                  width={coverPhoto?.width}
                  height={coverPhoto?.height}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </a>
              <div class="gallery-card-copy">
                <p class="eyebrow">Collection {String(index + 1).padStart(2, "0")}</p>
                <h2>{gallery.data.title}</h2>
                <p>{gallery.data.description}</p>
                <div class="meta">
                  <span>{formatDate(gallery.data.date)}</span>
                  {gallery.data.location && <span>{gallery.data.location}</span>}
                  <span>{gallery.data.photos.length} photographs</span>
                </div>
                <a class="text-link" href={`/photography/${slug}/`}>
                  View collection
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
