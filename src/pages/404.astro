---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page does not exist, or has moved elsewhere.">
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lead">
        The path ends here. The page may have moved, or may not yet have been published.
      </p>
      <a class="button" href="/">Return home</a>
    </div>
  </section>
</BaseLayout>
